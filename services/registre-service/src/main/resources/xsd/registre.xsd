<?xml version="1.0" encoding="UTF-8"?>
<!--
  Contrat SOAP du registre national des donneurs (système hérité simulé).
  Spring-WS génère le WSDL à partir de ce fichier : chaque opération est
  un couple d'éléments XxxRequest / XxxResponse.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://donsang.com/registre/v1"
           elementFormDefault="qualified">

  <!-- Opération 1 : le donneur est-il connu du registre ? -->
  <xs:element name="VerifierExistenceRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="identifiantNational" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="VerifierExistenceResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="existe" type="xs:boolean"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Opération 2 : éligibilité. SOAP Fault si le donneur est inconnu. -->
  <xs:element name="VerifierEligibiliteRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="identifiantNational" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="VerifierEligibiliteResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="eligible" type="xs:boolean"/>
        <xs:element name="motif" type="xs:string" minOccurs="0"/>
        <xs:element name="prochainDonPossible" type="xs:date" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Opération 3 : enregistrement officiel. SOAP Fault si inconnu ou inéligible. -->
  <xs:element name="EnregistrerDonRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="identifiantNational" type="xs:string"/>
        <xs:element name="dateDon" type="xs:date"/>
        <xs:element name="groupe" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="EnregistrerDonResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="numeroEnregistrement" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Opération 4 : donneurs pouvant donner maintenant (alerte en cas de pénurie). -->
  <xs:element name="ListerDonneursEligiblesRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="groupe" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ListerDonneursEligiblesResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="identifiantNational" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Opération 5 : même filtre que l'opération 4, avec les coordonnées des donneurs
       (appel aux donneurs, T16). Ajout : les opérations 1 à 4 sont inchangées. -->
  <xs:element name="ListerDonneursEligiblesDetailRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="groupe" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="ListerDonneursEligiblesDetailResponse">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="donneur" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="identifiantNational" type="xs:string"/>
              <xs:element name="nom" type="xs:string"/>
              <xs:element name="prenom" type="xs:string"/>
              <xs:element name="telephone" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
