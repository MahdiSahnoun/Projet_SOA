<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- POM parent : Java 17, Spring Boot 3.3.x, versions communes à tous les modules -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.donsang</groupId>
  <artifactId>dons-de-sang</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Plateforme de dons de sang</name>

  <modules>
    <module>contrats/inventaire-grpc</module>
    <module>contrats/registre-soap</module>
    <module>services/dons</module>
    <!-- à ajouter par les autres membres : gateway, services/inventaire, services/registre, outils/simulateur -->
  </modules>

  <properties>
    <java.version>17</java.version>
    <grpc.version>1.63.0</grpc.version>
    <protobuf.version>3.25.3</protobuf.version>
    <grpc-starter.version>3.1.0.RELEASE</grpc-starter.version>
    <jjwt.version>0.12.6</jjwt.version>
    <resilience4j.version>2.2.0</resilience4j.version>
    <springdoc.version>2.6.0</springdoc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>com.donsang</groupId>
        <artifactId>inventaire-grpc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.donsang</groupId>
        <artifactId>registre-soap</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
