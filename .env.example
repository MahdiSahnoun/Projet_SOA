# Variables lues par docker-compose.yml (racine du dépôt).
# Copier ce fichier en .env :   copy .env.example .env   (PowerShell)
# Le fichier .env n'est jamais commité (voir .gitignore). Sans .env, les valeurs
# par défaut du Compose sont utilisées : ce sont les mêmes valeurs de démo qu'ici.
# Attention : un mot de passe de base n'est pris en compte qu'à la création du volume.
# Pour le changer ensuite : docker compose down -v (supprime les données).

# Base du service Dons (dons_db)
DB_USER=dons_user
DB_PASSWORD=dons_password

# Base du service Inventaire (inventaire_db), utilisateur postgres
INVENTAIRE_DB_PASSWORD=postgres

# Base du service Registre (registre_db), utilisateur postgres
REGISTRE_DB_PASSWORD=postgres

# Secret de signature des JWT du service Dons : au moins 32 caractères aléatoires.
# PowerShell : $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-characters

# Mot de passe des comptes de démo créés par Dons au démarrage
# (donneur@test.tn, hopital@test.tn, banque-a@test.tn, banque-b@test.tn). Vide = aucun compte.
COMPTES_TEST_MDP=Demo2026!

# pgAdmin (http://localhost:5050)
PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin
